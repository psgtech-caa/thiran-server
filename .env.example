# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DATABASE_URL=postgresql://thiran_user:your_password@localhost:5432/thiran_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thiran_db
DB_USER=thiran_user
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=7d

# Email Configuration (College SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=thiran@psgtech.ac.in
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=Thiran 2026 - PSG Tech <thiran@psgtech.ac.in>

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# OTP Configuration
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3

# Session Configuration
SESSION_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_LOGIN_MAX=10

# Security
ALLOWED_EMAIL_DOMAIN=psgtech.ac.in

# Logging
LOG_LEVEL=info
